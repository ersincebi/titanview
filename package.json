{
  "name": "titanview",
  "version": "1.0.3",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "TitanView — Local-First SQLite Charting & TitanScript Terminal (Crypto + BIST .IS + US Stocks)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "node scripts/build-wasm.mjs --check && node scripts/build-script-server.mjs --check && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "script:server": "node scripts/build-script-server.mjs",
    "wasm:build": "node scripts/build-wasm.mjs",
    "tauri": "tauri",
    "desktop:dev": "node scripts/build-sidecar.mjs && tauri dev",
    "desktop:build": "tauri build",
    "sidecar": "node scripts/build-sidecar.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lightweight-charts": "^5.3.0",
    "monaco-editor": "0.52.2",
    "solid-js": "^1.9.19"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "2.1.9",
    "esbuild": "0.21.5",
    "jsdom": "^31.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.5",
    "vite-plugin-solid": "^2.11.16",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.30.3"
}
