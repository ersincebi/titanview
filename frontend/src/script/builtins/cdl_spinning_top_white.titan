//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Beyaz Topaç
// @category pattern
// @desc Mum formasyonu — nötr sinyali (STW)
indicator("Spinning Top White", "STW", overlay=true)
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
bodySize = bodyTop - bodyBot
barRange = high - low
upperWick = high - bodyTop
lowerWick = bodyBot - low
avgBody = ta.ema(bodySize, 14)
isSmall = bodySize < avgBody
isBull = close > open
isDojiBody = barRange > 0 and bodySize <= barRange * 0.05
detected = isBull and isSmall and bodySize > 0 and not isDojiBody and upperWick > bodySize and lowerWick > bodySize
plotshape(detected, "Spinning Top White", style=shape.labeldown, location=location.abovebar, color=color.new(#787B86, 0), text="STW", textcolor=color.white, size=size.small)
