// @desc Aralık genişlemesiyle dönüş tespiti
indicator("Mass Index", "Mass Index", overlay=false)
sumLen = input.int(10, "Length", minval=1)
hlRange = high - low
emaSingle = ta.ema(hlRange, 9)
emaDouble = ta.ema(emaSingle, 9)
massVal = math.sum(emaSingle / emaDouble, sumLen)
plot(massVal, "Mass Index", color=#0284C7)
