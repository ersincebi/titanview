//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Düşen Üç Yöntem
// @category pattern
// @desc Mum formasyonu — ayı (düşüş) sinyali (F3M)
indicator("Falling Three Methods", "F3M", overlay=true)
trendMode = input.string("SMA50", "Detect Trend Based On", options=["SMA50", "SMA50, SMA200", "No detection"])
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
inDowntrend = trendMode == "No detection" ? true : trendMode == "SMA50" ? close < sma50 : close < sma50 and sma50 < sma200
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
bodySize = bodyTop - bodyBot
avgBody = ta.ema(bodySize, 14)
isSmall = bodySize < avgBody
isLong = bodySize > avgBody
isBull = close > open
isBear = close < open
detected = inDowntrend[4] and isBear[4] and isLong[4] and isBull[3] and isSmall[3] and isBull[2] and isSmall[2] and isBull[1] and isSmall[1] and high[3] <= high[4] and low[3] >= low[4] and high[2] <= high[4] and low[2] >= low[4] and high[1] <= high[4] and low[1] >= low[4] and isBear and isLong and close < close[4]
plotshape(detected, "Falling Three Methods", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="F3M", textcolor=color.white, size=size.small)
