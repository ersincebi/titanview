//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Korelasyon Katsayısı
// @category other
// @desc Başka bir sembolle kapanış korelasyonu
indicator("Correlation Coefficient", "CC", overlay=false, format=format.price, precision=2)
symbolInput = input.symbol("XU100.IS", "Symbol")
sourceInput = input.source(close, "Source")
lengthInput = input.int(20, "Length", minval=2)
s2 = request.security(symbolInput, timeframe.period, sourceInput)
plot(ta.correlation(sourceInput, s2, lengthInput), "Correlation", color=#0284C7, style=plot.style_area)
hline(1, "Upper", color=#787B86)
hline(0, "Zero", color=#787B86, linestyle=hline.style_dashed)
hline(-1, "Lower", color=#787B86)
