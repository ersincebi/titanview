//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Harami Ayı
// @category pattern
// @desc Mum formasyonu — ayı (düşüş) sinyali (BH)
indicator("Harami - Bearish", "BH", overlay=true)
trendMode = input.string("SMA50", "Detect Trend Based On", options=["SMA50", "SMA50, SMA200", "No detection"])
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
inUptrend = trendMode == "No detection" ? true : trendMode == "SMA50" ? close > sma50 : close > sma50 and sma50 > sma200
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
bodySize = bodyTop - bodyBot
avgBody = ta.ema(bodySize, 14)
isSmall = bodySize < avgBody
isLong = bodySize > avgBody
isBull = close > open
isBear = close < open
detected = inUptrend and isBull[1] and isLong[1] and isBear and isSmall and high <= bodyTop[1] and low >= bodyBot[1]
plotshape(detected, "Harami - Bearish", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="BH", textcolor=color.white, size=size.small)
