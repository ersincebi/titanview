// @tr Chande Momentum Osilatörü
// @category osc
// @desc Yukarı/aşağı değişim farkı oranı
indicator("Chande Momentum Oscillator", "ChandeMO", overlay=false, format=format.price, precision=2)
period = input.int(9, "Length", minval=1)
price = input.source(close, "Source")
delta = price - price[1]
upSum = math.sum(delta > 0 ? delta : 0.0, period)
dnSum = math.sum(delta < 0 ? -delta : 0.0, period)
cmoVal = 100.0 * (upSum - dnSum) / (upSum + dnSum)
plot(cmoVal, "Chande MO", color=#0284C7)
hline(0, "Zero Line", color=#64748B, linestyle=hline.style_dashed)
