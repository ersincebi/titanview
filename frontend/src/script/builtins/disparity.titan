//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Uzaklık Endeksi
// @category osc
// @desc Fiyatın ortalamadan yüzde uzaklığı
indicator("Disparity Index", "DI", overlay=false, format=format.price, precision=2)
length = input.int(14, "Length", minval=1)
src = input(close, "Source")
ma = ta.ema(src, length)
plot(100 * (src - ma) / ma, "Disparity", color=#0284C7, style=plot.style_columns)
hline(0, "Zero", color=#787B86)
