//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Know Sure Thing
// @category osc
// @desc Dört ROC'un ağırlıklı toplamı
indicator("Know Sure Thing", "KST", overlay=false, format=format.price, precision=4)
r1 = input.int(10, "ROC Length #1", minval=1)
r2 = input.int(15, "ROC Length #2", minval=1)
r3 = input.int(20, "ROC Length #3", minval=1)
r4 = input.int(30, "ROC Length #4", minval=1)
s1 = input.int(10, "SMA Length #1", minval=1)
s2 = input.int(10, "SMA Length #2", minval=1)
s3 = input.int(10, "SMA Length #3", minval=1)
s4 = input.int(15, "SMA Length #4", minval=1)
sigLen = input.int(9, "Signal Line Length", minval=1)
c1 = ta.sma(ta.roc(close, r1), s1)
c2 = ta.sma(ta.roc(close, r2), s2)
c3 = ta.sma(ta.roc(close, r3), s3)
c4 = ta.sma(ta.roc(close, r4), s4)
kstVal = c1 + 2.0 * c2 + 3.0 * c3 + 4.0 * c4
plot(kstVal, "KST", color=#089981)
plot(ta.sma(kstVal, sigLen), "Signal", color=#F23645)
hline(0, "Zero", color=#64748B)
