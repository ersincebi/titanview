//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Açılış Aralığı
// @category other
// @desc Seansın ilk N barının yüksek/düşük aralığı
indicator("Opening Range", "ORB", overlay=true)
bars = input.int(4, "Opening bars", minval=1)
var float orH = na
var float orL = na
var int count = 0
if timeframe.change("D")
    orH := high
    orL := low
    count := 1
else if count < bars
    orH := math.max(orH, high)
    orL := math.min(orL, low)
    count += 1
u = plot(orH, "OR High", color=#0284C7, style=plot.style_stepline)
l = plot(orL, "OR Low", color=#0284C7, style=plot.style_stepline)
fill(u, l, color=color.new(#0284C7, 92), title="Range")
