//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Göreceli Volatilite Endeksi
// @category osc
// @desc Standart sapmanın yön dağılımı
indicator("Relative Volatility Index", "RVI", overlay=false, format=format.price, precision=2)
stdLen = input.int(10, "Length", minval=1)
smoothLen = input.int(14, "Smoothing", minval=1)
sd = ta.stdev(close, stdLen)
upVol = ta.ema(close > close[1] ? sd : 0.0, smoothLen)
dnVol = ta.ema(close <= close[1] ? sd : 0.0, smoothLen)
rviVal = 100.0 * upVol / (upVol + dnVol)
hiLine = hline(80, "Upper Band", color=#64748B)
hline(50, "Middle Band", color=color.new(#64748B, 50))
loLine = hline(20, "Lower Band", color=#64748B)
fill(hiLine, loLine, color=color.new(#8B5CF6, 90), title="Background")
plot(rviVal, "RVI", color=#8B5CF6)
