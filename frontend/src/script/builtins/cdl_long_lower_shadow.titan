// @tr Uzun Alt Gölge
// @category pattern
// @desc Mum formasyonu — boğa (yükseliş) sinyali (LS)
indicator("Long Lower Shadow", "LS", overlay=true)
bodyBot = math.min(open, close)
barRange = high - low
lowerWick = bodyBot - low
detected = barRange > 0 and lowerWick >= barRange * 0.75
plotshape(detected, "Long Lower Shadow", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="LS", textcolor=color.white, size=size.small)
