//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Kayan VWAP
// @category volume
// @desc Son N barın VWAP'ı
indicator("Rolling VWAP", "RVWAP", overlay=true)
length = input.int(20, "Length (bars)", minval=1)
src = input(hlc3, "Source")
mult = input.float(1.0, "Bands Multiplier", step=0.5, minval=0)
sv = math.sum(volume, length)
v = math.sum(src * volume, length) / sv
sd = math.sqrt(math.max(math.sum(volume * src * src, length) / sv - v * v, 0))
plot(v, "Rolling VWAP", color=#0284C7)
u = plot(v + sd * mult, "Upper Band", color=color.new(#089981, 30))
l = plot(v - sd * mult, "Lower Band", color=color.new(#089981, 30))
fill(u, l, color=color.new(#089981, 94), title="Bands Fill")
