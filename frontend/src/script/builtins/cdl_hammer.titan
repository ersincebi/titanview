//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Çekiç
// @category pattern
// @desc Mum formasyonu — boğa (yükseliş) sinyali (H)
indicator("Hammer", "H", overlay=true)
trendMode = input.string("SMA50", "Detect Trend Based On", options=["SMA50", "SMA50, SMA200", "No detection"])
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
inDowntrend = trendMode == "No detection" ? true : trendMode == "SMA50" ? close < sma50 : close < sma50 and sma50 < sma200
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
bodySize = bodyTop - bodyBot
barRange = high - low
upperWick = high - bodyTop
lowerWick = bodyBot - low
avgBody = ta.ema(bodySize, 14)
isSmall = bodySize < avgBody
detected = inDowntrend and isSmall and bodySize > 0 and lowerWick >= bodySize * 2.0 and upperWick <= barRange * 0.05
plotshape(detected, "Hammer", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="H", textcolor=color.white, size=size.small)
