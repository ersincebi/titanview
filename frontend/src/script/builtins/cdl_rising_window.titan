//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Yükselen Pencere
// @category pattern
// @desc Mum formasyonu — boğa (yükseliş) sinyali (RW)
indicator("Rising Window", "RW", overlay=true)
trendMode = input.string("SMA50", "Detect Trend Based On", options=["SMA50", "SMA50, SMA200", "No detection"])
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
inUptrend = trendMode == "No detection" ? true : trendMode == "SMA50" ? close > sma50 : close > sma50 and sma50 > sma200
barRange = high - low
detected = inUptrend[1] and barRange > 0 and barRange[1] > 0 and low > high[1]
plotshape(detected, "Rising Window", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="RW", textcolor=color.white, size=size.small)
