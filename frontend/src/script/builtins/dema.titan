// @tr Çift Üstel Ortalama
// @category ma
// @desc 2·EMA − EMA(EMA)
indicator("Double EMA", "DEMA", overlay=true)
period = input.int(9, "Length", minval=1)
price = input.source(close, "Source")
shift = input.int(0, "Offset", minval=-500, maxval=500)
ema1 = ta.ema(price, period)
ema2 = ta.ema(ema1, period)
demaVal = 2.0 * ema1 - ema2
plot(demaVal, "DEMA", color=#0284C7, offset=shift)
