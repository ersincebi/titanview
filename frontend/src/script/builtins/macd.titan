//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr MACD
// @category osc
// @desc Hızlı/yavaş EMA farkı, sinyal ve histogram
indicator("Moving Average Convergence Divergence", "MACD", overlay=false)
fastLen = input.int(12, "Fast Length", minval=1)
slowLen = input.int(26, "Slow Length", minval=1)
price = input.source(close, "Source")
sigLen = input.int(9, "Signal Smoothing", minval=1, maxval=50)
oscKind = input.string("EMA", "Oscillator MA Type", options=["SMA", "EMA"])
sigKind = input.string("EMA", "Signal Line MA Type", options=["SMA", "EMA"])
fastAvg = oscKind == "SMA" ? ta.sma(price, fastLen) : ta.ema(price, fastLen)
slowAvg = oscKind == "SMA" ? ta.sma(price, slowLen) : ta.ema(price, slowLen)
macdLine = fastAvg - slowAvg
sigLine = sigKind == "SMA" ? ta.sma(macdLine, sigLen) : ta.ema(macdLine, sigLen)
histVal = macdLine - sigLine
hline(0, "Zero Line", color=color.new(#64748B, 50))
histCol = histVal >= 0 ? (histVal >= histVal[1] ? #089981 : #99F6E4) : (histVal <= histVal[1] ? #F23645 : #FECACA)
plot(histVal, "Histogram", style=plot.style_columns, color=histCol)
plot(macdLine, "MACD", color=#0284C7)
plot(sigLine, "Signal", color=#F59E0B)
