// @tr Fiyat Hacim Trendi
// @category volume
// @desc Yüzde değişim × hacim kümülatifi
indicator("Price Volume Trend", "PVT", overlay=false, format=format.volume)
ret = (close - close[1]) / close[1]
plot(ta.cum(ret * volume), "PVT", color=#0284C7)
