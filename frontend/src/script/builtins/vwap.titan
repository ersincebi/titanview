//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Hacim Ağırlıklı Ortalama Fiyat
// @category volume
// @desc Çapa dönemine göre VWAP ve standart sapma bantları
indicator("Volume Weighted Average Price", "VWAP", overlay=true)
resetKind = input.string("Session", "Anchor Period", options=["Session", "Week", "Month", "Quarter", "Year"])
price = input.source(hlc3, "Source")
band1On = input.bool(true, "Band #1", inline="b1")
band1Mult = input.float(1.0, "Mult #1", inline="b1", step=0.5, minval=0)
band2On = input.bool(false, "Band #2", inline="b2")
band2Mult = input.float(2.0, "Mult #2", inline="b2", step=0.5, minval=0)
isNew = resetKind == "Session" ? timeframe.change("D") : resetKind == "Week" ? timeframe.change("W") : resetKind == "Month" ? timeframe.change("M") : resetKind == "Quarter" ? timeframe.change("3M") : timeframe.change("12M")
var float cumPV = 0.0
var float cumV = 0.0
var float cumPV2 = 0.0
if isNew or barstate.isfirst
    cumPV := 0.0
    cumV := 0.0
    cumPV2 := 0.0
cumPV += price * volume
cumV += volume
cumPV2 += volume * price * price
vwapLine = cumV > 0 ? cumPV / cumV : na
sd = cumV > 0 ? math.sqrt(math.max(cumPV2 / cumV - vwapLine * vwapLine, 0.0)) : na
plot(vwapLine, "VWAP", color=#0284C7)
u1 = plot(band1On ? vwapLine + sd * band1Mult : na, "Upper Band #1", color=#089981)
l1 = plot(band1On ? vwapLine - sd * band1Mult : na, "Lower Band #1", color=#089981)
fill(u1, l1, color=color.new(#089981, 94), title="Bands Fill #1")
u2 = plot(band2On ? vwapLine + sd * band2Mult : na, "Upper Band #2", color=#64748B)
l2 = plot(band2On ? vwapLine - sd * band2Mult : na, "Lower Band #2", color=#64748B)
fill(u2, l2, color=color.new(#64748B, 94), title="Bands Fill #2")
