//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Cımbız Tepe
// @category pattern
// @desc Mum formasyonu — ayı (düşüş) sinyali (TT)
indicator("Tweezer Top", "TT", overlay=true)
trendMode = input.string("SMA50", "Detect Trend Based On", options=["SMA50", "SMA50, SMA200", "No detection"])
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
inUptrend = trendMode == "No detection" ? true : trendMode == "SMA50" ? close > sma50 : close > sma50 and sma50 > sma200
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
bodySize = bodyTop - bodyBot
avgBody = ta.ema(bodySize, 14)
isBull = close > open
isBear = close < open
detected = inUptrend[1] and isBull[1] and isBear and math.abs(high - high[1]) <= avgBody * 0.05
plotshape(detected, "Tweezer Top", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="TT", textcolor=color.white, size=size.small)
