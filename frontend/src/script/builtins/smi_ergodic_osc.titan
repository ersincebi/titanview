// @tr SMI Ergodik Osilatör
// @category osc
// @desc TSI − sinyal histogramı
indicator("SMI Ergodic Oscillator", "SMIO", overlay=false, format=format.price, precision=4)
slowLen = input.int(20, "Long Length", minval=1)
fastLen = input.int(5, "Short Length", minval=1)
sigLen = input.int(5, "Signal Line Length", minval=1)
ergVal = ta.tsi(close, fastLen, slowLen)
sigVal = ta.ema(ergVal, sigLen)
plot(ergVal - sigVal, "SMI Ergodic Oscillator", style=plot.style_histogram, color=#F23645)
