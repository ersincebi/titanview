//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Siyah Topaç
// @category pattern
// @desc Mum formasyonu — nötr sinyali (STB)
indicator("Spinning Top Black", "STB", overlay=true)
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
bodySize = bodyTop - bodyBot
barRange = high - low
upperWick = high - bodyTop
lowerWick = bodyBot - low
avgBody = ta.ema(bodySize, 14)
isSmall = bodySize < avgBody
isBear = close < open
isDojiBody = barRange > 0 and bodySize <= barRange * 0.05
detected = isBear and isSmall and bodySize > 0 and not isDojiBody and upperWick > bodySize and lowerWick > bodySize
plotshape(detected, "Spinning Top Black", style=shape.labeldown, location=location.abovebar, color=color.new(#787B86, 0), text="STB", textcolor=color.white, size=size.small)
