//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Süper Trend
// @category trend
// @desc ATR tabanlı iz süren trend stopu
indicator("Supertrend", "Supertrend", overlay=true)
atrLen = input.int(10, "ATR Length", minval=1)
mult = input.float(3.0, "Factor", minval=0.01, step=0.01)
[stVal, trendDir] = ta.supertrend(mult, atrLen)
stLine = barstate.isfirst ? na : stVal
midPlot = plot(barstate.isfirst ? na : (open + close) / 2.0, "Midline", display=display.none)
bullPlot = plot(trendDir < 0 ? stLine : na, "Up Trend", color=#089981, style=plot.style_linebr)
bearPlot = plot(trendDir > 0 ? stLine : na, "Down Trend", color=#F23645, style=plot.style_linebr)
fill(midPlot, bullPlot, color=color.new(#089981, 90), title="Uptrend Fill")
fill(midPlot, bearPlot, color=color.new(#F23645, 90), title="Downtrend Fill")
alertcondition(trendDir < 0 and trendDir[1] > 0, title="Trend Turned Bullish", message="Supertrend flipped bullish")
alertcondition(trendDir > 0 and trendDir[1] < 0, title="Trend Turned Bearish", message="Supertrend flipped bearish")
