// @tr Sıfır Gecikmeli EMA
// @category ma
// @desc Gecikme düzeltilmiş EMA
indicator("Zero Lag EMA", "ZLEMA", overlay=true)
period = input.int(9, "Length", minval=1)
price = input.source(close, "Source")
shift = input.int(0, "Offset", minval=-500, maxval=500)
halfLag = math.floor((period - 1) / 2)
adjusted = 2.0 * price - price[halfLag]
plot(ta.ema(adjusted, period), "ZLEMA", color=#F59E0B, offset=shift)
