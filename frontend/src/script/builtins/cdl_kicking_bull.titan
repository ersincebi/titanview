//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Tekme Boğa
// @category pattern
// @desc Mum formasyonu — boğa (yükseliş) sinyali (K)
indicator("Kicking - Bullish", "K", overlay=true)
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
bodySize = bodyTop - bodyBot
upperWick = high - bodyTop
lowerWick = bodyBot - low
avgBody = ta.ema(bodySize, 14)
isLong = bodySize > avgBody
isBull = close > open
isBear = close < open
detected = isBear[1] and isLong[1] and upperWick[1] <= bodySize[1] * 0.05 and lowerWick[1] <= bodySize[1] * 0.05 and isBull and isLong and upperWick <= bodySize * 0.05 and lowerWick <= bodySize * 0.05 and open > open[1]
plotshape(detected, "Kicking - Bullish", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="K", textcolor=color.white, size=size.small)
