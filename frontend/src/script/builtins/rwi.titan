// @tr Rastgele Yürüyüş Endeksi
// @category trend
// @desc Hareketin rastgele yürüyüşe göre gücü
indicator("Random Walk Index", "RWI", overlay=false, format=format.price, precision=2)
length = input.int(14, "Length", minval=2)
atr = ta.atr(length)
rwiHigh = (high - low[length]) / (atr * math.sqrt(length))
rwiLow = (high[length] - low) / (atr * math.sqrt(length))
plot(rwiHigh, "RWI High", color=#089981)
plot(rwiLow, "RWI Low", color=#F23645)
hline(1, "Threshold", color=#787B86, linestyle=hline.style_dashed)
