//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Sıra Korelasyon Endeksi
// @category osc
// @desc Spearman sıra korelasyonu (−100..100)
indicator("Rank Correlation Index", "RCI", overlay=false, format=format.price, precision=2)
period = input.int(10, "RCI Length", minval=1)
price = input.source(close, "Source")
plot(ta.rci(price, period), "RCI", color=#0284C7)
hiLine = hline(80, "Upper Band", color=#64748B)
hline(0, "Middle Band", color=color.new(#64748B, 50))
loLine = hline(-80, "Lower Band", color=#64748B)
fill(hiLine, loLine, color=color.new(#0284C7, 90), title="Background")
