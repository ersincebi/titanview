// @tr Bollinger Bantları %B
// @category volatility
// @desc Fiyatın bantlar arasındaki konumu
indicator("Bollinger Bands %b", "BB %b", overlay=false, format=format.price, precision=2)
period = input.int(20, "Length", minval=1)
price = input.source(close, "Source")
k = input.float(2.0, "StdDev", minval=0.001, maxval=50.0)
mid = ta.sma(price, period)
halfW = k * ta.stdev(price, period)
hiBand = mid + halfW
loBand = mid - halfW
pctB = (price - loBand) / (hiBand - loBand)
plot(pctB, "Bollinger Bands %b", color=#089981)
hiLine = hline(1.0, "Overbought", color=#64748B, linestyle=hline.style_dashed)
hline(0.5, "Middle Band", color=color.new(#64748B, 50))
loLine = hline(0.0, "Oversold", color=#64748B, linestyle=hline.style_dashed)
fill(hiLine, loLine, color=color.new(#089981, 90), title="Background")
