// @tr Momentum
// @category osc
// @desc Kapanış − N bar önceki kapanış
indicator("Momentum", "Mom", overlay=false)
period = input.int(10, "Length", minval=1)
price = input.source(close, "Source")
plot(price - price[period], "MOM", color=#0284C7)
