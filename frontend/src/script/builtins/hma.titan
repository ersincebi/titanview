// @tr Hull Hareketli Ortalama
// @category ma
// @desc Gecikmesi azaltılmış ağırlıklı ortalama
indicator("Hull Moving Average", "HMA", overlay=true)
period = input.int(9, "Length", minval=1)
price = input.source(close, "Source")
shift = input.int(0, "Offset", minval=-500, maxval=500)
plot(ta.hma(price, period), "HMA", color=#0D9488, offset=shift)
