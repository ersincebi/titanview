//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr BB Trend
// @category volatility
// @desc Kısa/uzun Bollinger farkıyla trend gücü
indicator("BBTrend", "BBTrend", overlay=false, format=format.price, precision=2)
fastLen = input.int(20, "Short BB Length", minval=1)
slowLen = input.int(50, "Long BB Length", minval=1)
mult = input.float(2.0, "StdDev", minval=0.25, step=0.25)
[fastMid, fastHi, fastLo] = ta.bb(close, fastLen, mult)
[slowMid, slowHi, slowLo] = ta.bb(close, slowLen, mult)
score = (math.abs(fastLo - slowLo) - math.abs(fastHi - slowHi)) / slowMid * 100.0
barCol = score >= 0 ? (score > score[1] ? #089981 : #5EEAD4) : (score < score[1] ? #F23645 : #FCA5A5)
plot(score, "BBTrend", style=plot.style_columns, color=barCol)
hline(0, "Zero line", color=#64748B)
