// @tr Boğa Ayı Gücü
// @category osc
// @desc Yüksek+düşük − EMA
indicator("Bull Bear Power", "BBP", overlay=false, format=format.price, precision=2)
period = input.int(13, "Length", minval=1)
emaRef = ta.ema(close, period)
elderPower = (high - emaRef) + (low - emaRef)
plot(elderPower, "BBPower", style=plot.style_columns, color=#0284C7)
