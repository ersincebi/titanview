//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Kara Bulut Örtüsü
// @category pattern
// @desc Mum formasyonu — ayı (düşüş) sinyali (DCC)
indicator("Dark Cloud Cover", "DCC", overlay=true)
trendMode = input.string("SMA50", "Detect Trend Based On", options=["SMA50", "SMA50, SMA200", "No detection"])
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
inUptrend = trendMode == "No detection" ? true : trendMode == "SMA50" ? close > sma50 : close > sma50 and sma50 > sma200
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
bodySize = bodyTop - bodyBot
avgBody = ta.ema(bodySize, 14)
isLong = bodySize > avgBody
isBull = close > open
isBear = close < open
bodyMid = (bodyTop + bodyBot) * 0.5
detected = inUptrend and isBull[1] and isLong[1] and isBear and open > high[1] and close < bodyMid[1] and close > open[1]
plotshape(detected, "Dark Cloud Cover", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="DCC", textcolor=color.white, size=size.small)
