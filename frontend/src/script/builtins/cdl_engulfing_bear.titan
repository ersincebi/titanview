//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Yutan Ayı
// @category pattern
// @desc Mum formasyonu — ayı (düşüş) sinyali (BE)
indicator("Engulfing - Bearish", "BE", overlay=true)
trendMode = input.string("SMA50", "Detect Trend Based On", options=["SMA50", "SMA50, SMA200", "No detection"])
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
inUptrend = trendMode == "No detection" ? true : trendMode == "SMA50" ? close > sma50 : close > sma50 and sma50 > sma200
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
bodySize = bodyTop - bodyBot
avgBody = ta.ema(bodySize, 14)
isSmall = bodySize < avgBody
isLong = bodySize > avgBody
isBull = close > open
isBear = close < open
detected = inUptrend and isBear and isLong and isBull[1] and isSmall[1] and close <= open[1] and open >= close[1] and (close < open[1] or open > close[1])
plotshape(detected, "Engulfing - Bearish", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="BE", textcolor=color.white, size=size.small)
