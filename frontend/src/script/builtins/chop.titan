//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Dalgalılık Endeksi
// @category osc
// @desc Piyasanın yatay/trendli olma derecesi
indicator("Choppiness Index", "CHOP", overlay=false, format=format.price, precision=2)
period = input.int(14, "Length", minval=2)
shift = input.int(0, "Offset", minval=-500, maxval=500)
trSum = math.sum(ta.atr(1), period)
rangeSpan = ta.highest(high, period) - ta.lowest(low, period)
chopVal = 100.0 * math.log10(trSum / rangeSpan) / math.log10(period)
plot(chopVal, "CHOP", color=#0284C7, offset=shift)
hiLine = hline(61.8, "Upper Band", color=#64748B, linestyle=hline.style_dashed)
hline(50.0, "Middle Band", color=color.new(#64748B, 50))
loLine = hline(38.2, "Lower Band", color=#64748B, linestyle=hline.style_dashed)
fill(hiLine, loLine, color=color.new(#0284C7, 90), title="Background")
