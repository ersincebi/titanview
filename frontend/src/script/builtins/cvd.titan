//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Kümülatif Hacim Deltası
// @category volume
// @desc Alt zaman dilimine göre alış−satış hacmi kümülatifi (dönem çapalı)
indicator("Cumulative Volume Delta", "CVD", overlay=false, format=format.volume)
anchor = input.timeframe("1D", "Anchor period")
lowerTf = timeframe.isseconds ? "1S" : timeframe.isintraday ? "1" : timeframe.isdaily ? "5" : "60"
barDelta() =>
    close > open ? volume : close < open ? -volume : 0.0
deltas = request.security_lower_tf(syminfo.tickerid, lowerTf, barDelta())
d = array.size(deltas) > 0 ? array.sum(deltas) : (close > open ? volume : close < open ? -volume : 0.0)
var float cvd = 0.0
var float o = 0.0
if timeframe.change(anchor)
    cvd := 0.0
o := cvd
cvd += d
h = math.max(o, cvd)
l = math.min(o, cvd)
plotcandle(o, h, l, cvd, "CVD", color=cvd >= o ? #089981 : #F23645, wickcolor=#787B86, bordercolor=cvd >= o ? #089981 : #F23645)
