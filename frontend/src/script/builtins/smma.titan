// @tr Düzleştirilmiş Hareketli Ortalama
// @category ma
// @desc Wilder (RMA) düzleştirmesi
indicator("Smoothed Moving Average", "SMMA", overlay=true)
period = input.int(9, "Length", minval=1)
price = input.source(close, "Source")
shift = input.int(0, "Offset", minval=-500, maxval=500)
plot(ta.rma(price, period), "SMMA", color=#8B5CF6, offset=shift)
