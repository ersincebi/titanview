// @tr Chaikin Para Akışı
// @category volume
// @desc N barlık para akışı hacmi / hacim
indicator("Chaikin Money Flow", "CMF", overlay=false, format=format.price, precision=2)
period = input.int(20, "Length", minval=1)
span = high - low
mfMult = span == 0 ? 0.0 : ((close - low) - (high - close)) / span
mfVol = mfMult * volume
cmfVal = math.sum(mfVol, period) / math.sum(volume, period)
plot(cmfVal, "MF", color=#16A34A)
hline(0, "Zero", color=#64748B, linestyle=hline.style_dashed)
