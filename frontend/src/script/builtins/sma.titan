// @tr Basit Hareketli Ortalama
// @category ma
// @desc Son N kapanışın aritmetik ortalaması
indicator("Moving Average Simple", "SMA", overlay=true)
period = input.int(9, "Length", minval=1)
price = input.source(close, "Source")
shift = input.int(0, "Offset", minval=-500, maxval=500)
plot(ta.sma(price, period), "SMA", color=#0284C7, offset=shift)
