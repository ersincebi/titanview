// @desc İki sembolün kapanış oranı
indicator("Ratio", "Ratio", overlay=false, format=format.price, precision=4)
symbolInput = input.symbol("XU100.IS", "Second Symbol")
other = request.security(symbolInput, timeframe.period, close)
plot(close / other, "Ratio", color=#0284C7)
hline(1, "Parity", color=#787B86, linestyle=hline.style_dashed)
