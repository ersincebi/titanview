//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Doji
// @category pattern
// @desc Mum formasyonu — nötr sinyali (D)
indicator("Doji", "D", overlay=true)
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
bodySize = bodyTop - bodyBot
barRange = high - low
upperWick = high - bodyTop
lowerWick = bodyBot - low
isDojiBody = barRange > 0 and bodySize <= barRange * 0.05
detected = isDojiBody and upperWick > 0 and lowerWick > 0 and math.min(upperWick, lowerWick) / math.max(upperWick, lowerWick) >= 0.5
plotshape(detected, "Doji", style=shape.labeldown, location=location.abovebar, color=color.new(#787B86, 0), text="D", textcolor=color.white, size=size.small)
