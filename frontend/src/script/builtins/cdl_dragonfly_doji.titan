//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Yusufçuk Doji
// @category pattern
// @desc Mum formasyonu — boğa (yükseliş) sinyali (DD)
indicator("Dragonfly Doji", "DD", overlay=true)
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
bodySize = bodyTop - bodyBot
barRange = high - low
upperWick = high - bodyTop
lowerWick = bodyBot - low
isDojiBody = barRange > 0 and bodySize <= barRange * 0.05
detected = isDojiBody and upperWick <= barRange * 0.05 and lowerWick >= barRange * 0.6
plotshape(detected, "Dragonfly Doji", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="DD", textcolor=color.white, size=size.small)
