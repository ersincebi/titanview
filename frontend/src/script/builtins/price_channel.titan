//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Fiyat Kanalı
// @category volatility
// @desc Bir önceki barlara göre en yüksek/en düşük kanal
indicator("Price Channel", "PC", overlay=true)
period = input.int(20, "Length", minval=1)
shift = input.int(0, "Offset")
top = ta.highest(high, period)
bot = ta.lowest(low, period)
plot(top, "Upper", color=#E11D48, offset=shift)
plot(bot, "Lower", color=#E11D48, offset=shift)
plot((top + bot) / 2.0, "Center", color=#0284C7, offset=shift)
