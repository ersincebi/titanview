//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Fiyat Yüzde Osilatörü
// @category osc
// @desc EMA farkının yavaş EMA yüzdesi
indicator("Price Oscillator", "PPO", overlay=false, format=format.price, precision=2)
fastLen = input.int(10, "Short Length", minval=1)
slowLen = input.int(21, "Long Length", minval=1)
price = input.source(close, "Source")
useEma = input.bool(false, "Use exponential MA")
fastVal = useEma ? ta.ema(price, fastLen) : ta.sma(price, fastLen)
slowVal = useEma ? ta.ema(price, slowLen) : ta.sma(price, slowLen)
ppoVal = 100.0 * (fastVal - slowVal) / slowVal
plot(ppoVal, "Osc", color=#0284C7)
hline(0, "Zero Line", color=#64748B)
