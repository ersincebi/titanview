// @tr Üçlü Yıldız Ayı
// @category pattern
// @desc Mum formasyonu — ayı (düşüş) sinyali (3S)
indicator("Tri-Star - Bearish", "3S", overlay=true)
trendMode = input.string("SMA50", "Detect Trend Based On", options=["SMA50", "SMA50, SMA200", "No detection"])
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
inUptrend = trendMode == "No detection" ? true : trendMode == "SMA50" ? close > sma50 : close > sma50 and sma50 > sma200
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
bodySize = bodyTop - bodyBot
barRange = high - low
isDojiBody = barRange > 0 and bodySize <= barRange * 0.05
detected = inUptrend[2] and isDojiBody[2] and isDojiBody[1] and isDojiBody and bodyBot[1] > bodyTop[2] and bodyBot[1] > bodyTop
plotshape(detected, "Tri-Star - Bearish", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="3S", textcolor=color.white, size=size.small)
