// @tr Hacim Ağırlıklı Hareketli Ortalama
// @category ma
// @desc Hacimle ağırlıklandırılmış ortalama
indicator("Volume Weighted Moving Average", "VWMA", overlay=true)
period = input.int(20, "Length", minval=1)
price = input.source(close, "Source")
shift = input.int(0, "Offset", minval=-500, maxval=500)
plot(ta.vwma(price, period), "VWMA", color=#0284C7, offset=shift)
