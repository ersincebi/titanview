// @tr SMI Ergodik Gösterge
// @category osc
// @desc TSI ve sinyal hattı
indicator("SMI Ergodic Indicator", "SMII", overlay=false, format=format.price, precision=4)
slowLen = input.int(20, "Long Length", minval=1)
fastLen = input.int(5, "Short Length", minval=1)
sigLen = input.int(5, "Signal Line Length", minval=1)
ergVal = ta.tsi(close, fastLen, slowLen)
plot(ergVal, "SMI", color=#0284C7)
plot(ta.ema(ergVal, sigLen), "Signal", color=#F59E0B)
