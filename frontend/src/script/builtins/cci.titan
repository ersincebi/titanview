//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Emtia Kanal Endeksi
// @category osc
// @desc Tipik fiyatın ortalamadan sapması
indicator("Commodity Channel Index", "CCI", overlay=false)
period = input.int(20, "Length", minval=1)
price = input.source(hlc3, "Source")
maLen = input.int(14, "Smoothing Length", minval=1, group="Smoothing")
meanVal = ta.sma(price, period)
meanDev = ta.dev(price, period)
cciVal = (price - meanVal) / (0.015 * meanDev)
plot(cciVal, "CCI", color=#0284C7)
plot(ta.sma(cciVal, maLen), "CCI-based MA", color=#F59E0B)
hiBand = hline(100, "Upper Band", color=#64748B, linestyle=hline.style_dashed)
hline(0, "Middle Band", color=color.new(#64748B, 50))
loBand = hline(-100, "Lower Band", color=#64748B, linestyle=hline.style_dashed)
fill(hiBand, loBand, color=color.new(#0284C7, 90), title="Background")
