// @tr Bollinger Bant Genişliği
// @category volatility
// @desc Bant genişliğinin ortalamaya oranı
indicator("Bollinger BandWidth", "BBW", overlay=false, format=format.price, precision=2)
period = input.int(20, "Length", minval=1)
price = input.source(close, "Source")
k = input.float(2.0, "StdDev", minval=0.001, maxval=50.0)
expLookback = input.int(125, "Highest Expansion Length", minval=1)
conLookback = input.int(125, "Lowest Contraction Length", minval=1)
mid = ta.sma(price, period)
halfW = k * ta.stdev(price, period)
widthPct = (2.0 * halfW / mid) * 100.0
plot(widthPct, "Bollinger BandWidth", color=#0284C7)
plot(ta.highest(widthPct, expLookback), "Highest Expansion", color=color.new(#F23645, 50))
plot(ta.lowest(widthPct, conLookback), "Lowest Contraction", color=color.new(#089981, 50))
