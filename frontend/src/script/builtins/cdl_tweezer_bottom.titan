//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Cımbız Dip
// @category pattern
// @desc Mum formasyonu — boğa (yükseliş) sinyali (TB)
indicator("Tweezer Bottom", "TB", overlay=true)
trendMode = input.string("SMA50", "Detect Trend Based On", options=["SMA50", "SMA50, SMA200", "No detection"])
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
inDowntrend = trendMode == "No detection" ? true : trendMode == "SMA50" ? close < sma50 : close < sma50 and sma50 < sma200
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
bodySize = bodyTop - bodyBot
avgBody = ta.ema(bodySize, 14)
isBull = close > open
isBear = close < open
detected = inDowntrend[1] and isBear[1] and isBull and math.abs(low - low[1]) <= avgBody * 0.05
plotshape(detected, "Tweezer Bottom", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="TB", textcolor=color.white, size=size.small)
