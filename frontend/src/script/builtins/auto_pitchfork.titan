//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Otomatik Pitchfork
// @category auto
// @desc Son üç pivottan Andrews dirgeni
indicator("Auto Pitchfork", "Auto Pitchfork", overlay=true, max_lines_count=10)
depth = input.int(10, "Depth", minval=2)
var array<float> pp = array.new<float>()
var array<int> pb = array.new<int>()
var array<bool> pk = array.new<bool>()
push(float price, int bar, bool isHigh) =>
    n = array.size(pp)
    if n > 0 and array.get(pk, n - 1) == isHigh
        last = array.get(pp, n - 1)
        if (isHigh and price > last) or (not isHigh and price < last)
            array.set(pp, n - 1, price)
            array.set(pb, n - 1, bar)
    else
        array.push(pp, price)
        array.push(pb, bar)
        array.push(pk, isHigh)
        if array.size(pp) > 3
            array.shift(pp)
            array.shift(pb)
            array.shift(pk)
ph = ta.pivothigh(high, depth, depth)
pl = ta.pivotlow(low, depth, depth)
if not na(ph)
    push(ph, bar_index - depth, true)
if not na(pl)
    push(pl, bar_index - depth, false)
var array<line> ls = array.new<line>()
if barstate.islast and array.size(pp) == 3
    for l in ls
        line.delete(l)
    array.clear(ls)
    x0 = array.get(pb, 0)
    y0 = array.get(pp, 0)
    x1 = array.get(pb, 1)
    y1 = array.get(pp, 1)
    x2 = array.get(pb, 2)
    y2 = array.get(pp, 2)
    mx = (x1 + x2) / 2.0
    my = (y1 + y2) / 2.0
    slope = mx != x0 ? (my - y0) / (mx - x0) : 0.0
    xe = bar_index
    array.push(ls, line.new(x0, y0, xe, y0 + slope * (xe - x0), color=#F23645, width=2))
    array.push(ls, line.new(x1, y1, xe, y1 + slope * (xe - x1), color=#0284C7))
    array.push(ls, line.new(x2, y2, xe, y2 + slope * (xe - x2), color=#0284C7))
    array.push(ls, line.new(x1, y1, x2, y2, color=color.new(#787B86, 30), style=line.style_dashed))
    array.push(ls, line.new(x0, y0, x1, y1, color=color.new(#787B86, 30), style=line.style_dotted))
