//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Gün İçi Momentum Endeksi
// @category osc
// @desc Mum gövdelerine dayalı RSI benzeri
indicator("Intraday Momentum Index", "IMI", overlay=false, format=format.price, precision=2)
length = input.int(14, "Length", minval=1)
gain = close > open ? close - open : 0
loss = close < open ? open - close : 0
imi = 100 * math.sum(gain, length) / (math.sum(gain, length) + math.sum(loss, length))
plot(imi, "IMI", color=#7E57C2)
hline(70, "Upper", color=#787B86)
hline(30, "Lower", color=#787B86)
