//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Yukarı Tasuki Boşluğu
// @category pattern
// @desc Mum formasyonu — boğa (yükseliş) sinyali (UTG)
indicator("Upside Tasuki Gap", "UTG", overlay=true)
trendMode = input.string("SMA50", "Detect Trend Based On", options=["SMA50", "SMA50, SMA200", "No detection"])
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
inUptrend = trendMode == "No detection" ? true : trendMode == "SMA50" ? close > sma50 : close > sma50 and sma50 > sma200
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
isBull = close > open
isBear = close < open
detected = inUptrend[2] and isBull[2] and isBull[1] and bodyBot[1] > bodyTop[2] and isBear and open >= bodyBot[1] and open <= bodyTop[1] and close < bodyBot[1] and close > bodyTop[2]
plotshape(detected, "Upside Tasuki Gap", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="UTG", textcolor=color.white, size=size.small)
