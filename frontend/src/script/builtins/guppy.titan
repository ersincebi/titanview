//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Guppy Çoklu Hareketli Ortalama
// @category ma
// @desc Kısa (yatırımcı) ve uzun (yatırımcı) EMA grupları
indicator("Guppy Multiple Moving Average", "GMMA", overlay=true)
src = input(close, "Source")
plot(ta.ema(src, 3), "Trader EMA 1", color=#00B8D4)
plot(ta.ema(src, 5), "Trader EMA 2", color=#00B8D4)
plot(ta.ema(src, 8), "Trader EMA 3", color=#00B8D4)
plot(ta.ema(src, 10), "Trader EMA 4", color=#00B8D4)
plot(ta.ema(src, 12), "Trader EMA 5", color=#00B8D4)
plot(ta.ema(src, 15), "Trader EMA 6", color=#00B8D4)
plot(ta.ema(src, 30), "Investor EMA 1", color=#F23645)
plot(ta.ema(src, 35), "Investor EMA 2", color=#F23645)
plot(ta.ema(src, 40), "Investor EMA 3", color=#F23645)
plot(ta.ema(src, 45), "Investor EMA 4", color=#F23645)
plot(ta.ema(src, 50), "Investor EMA 5", color=#F23645)
plot(ta.ema(src, 60), "Investor EMA 6", color=#F23645)
