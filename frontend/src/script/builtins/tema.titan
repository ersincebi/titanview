// @tr Üçlü Üstel Ortalama
// @category ma
// @desc 3·(e1 − e2) + e3
indicator("Triple EMA", "TEMA", overlay=true)
period = input.int(9, "Length", minval=1)
price = input.source(close, "Source")
shift = input.int(0, "Offset", minval=-500, maxval=500)
ema1 = ta.ema(price, period)
ema2 = ta.ema(ema1, period)
ema3 = ta.ema(ema2, period)
plot(3.0 * (ema1 - ema2) + ema3, "TEMA", color=#0284C7, offset=shift)
