// @tr Nihai Osilatör
// @category osc
// @desc Üç dönemli alım baskısı ortalaması
indicator("Ultimate Oscillator", "UO", overlay=false)
p1 = input.int(7, "Fast Length", minval=1)
p2 = input.int(14, "Middle Length", minval=1)
p3 = input.int(28, "Slow Length", minval=1)
trueLow = math.min(low, close[1])
trueHigh = math.max(high, close[1])
buyPress = close - trueLow
trueRng = trueHigh - trueLow
r1 = math.sum(buyPress, p1) / math.sum(trueRng, p1)
r2 = math.sum(buyPress, p2) / math.sum(trueRng, p2)
r3 = math.sum(buyPress, p3) / math.sum(trueRng, p3)
uoVal = 100.0 * (4.0 * r1 + 2.0 * r2 + r3) / 7.0
plot(uoVal, "UO", color=#F23645)
