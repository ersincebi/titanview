// @desc Son fiyatlara daha çok ağırlık veren ortalama
indicator("Moving Average Exponential", "EMA", overlay=true)
period = input.int(9, "Length", minval=1)
price = input.source(close, "Source")
shift = input.int(0, "Offset", minval=-500, maxval=500)
plot(ta.ema(price, period), "EMA", color=#0284C7, offset=shift)
