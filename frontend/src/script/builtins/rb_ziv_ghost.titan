// @tr Haftalık Yarım Pivotlar
// @category other
// @desc Haftalık pivot ve yarım seviyeler
indicator("Weekly Midpoint Pivots", "Weekly Mid", overlay=true)
var float curHi = na
var float curLo = na
var float prevHi = na
var float prevLo = na
var float prevCl = na
if timeframe.change("W")
    prevHi := curHi
    prevLo := curLo
    prevCl := close[1]
    curHi := high
    curLo := low
else
    curHi := na(curHi) ? high : math.max(curHi, high)
    curLo := na(curLo) ? low : math.min(curLo, low)
pv = (prevHi + prevLo + prevCl) / 3.0
r1 = 2.0 * pv - prevLo
s1 = 2.0 * pv - prevHi
plot(pv, "Weekly PP", color=#8B5CF6, style=plot.style_stepline)
plot((pv + r1) / 2.0, "Mid R0.5", color=color.new(#F23645, 40), style=plot.style_stepline)
plot((pv + s1) / 2.0, "Mid S0.5", color=color.new(#089981, 40), style=plot.style_stepline)
plot(r1, "Weekly R1", color=#F23645, style=plot.style_stepline)
plot(s1, "Weekly S1", color=#089981, style=plot.style_stepline)
