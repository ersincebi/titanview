//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Delen Mum
// @category pattern
// @desc Mum formasyonu — boğa (yükseliş) sinyali (P)
indicator("Piercing", "P", overlay=true)
trendMode = input.string("SMA50", "Detect Trend Based On", options=["SMA50", "SMA50, SMA200", "No detection"])
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
inDowntrend = trendMode == "No detection" ? true : trendMode == "SMA50" ? close < sma50 : close < sma50 and sma50 < sma200
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
bodySize = bodyTop - bodyBot
avgBody = ta.ema(bodySize, 14)
isLong = bodySize > avgBody
isBull = close > open
isBear = close < open
bodyMid = (bodyTop + bodyBot) * 0.5
detected = inDowntrend and isBear[1] and isLong[1] and isBull and open < low[1] and close > bodyMid[1] and close < open[1]
plotshape(detected, "Piercing", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="P", textcolor=color.white, size=size.small)
