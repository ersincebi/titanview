//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Tüm Mum Formasyonları
// @category pattern
// @desc 44 mum formasyonunu tek göstergede tarar (boğa/ayı/nötr filtreli)
indicator("All Candlestick Patterns", "All Patterns", overlay=true)
showBull = input.bool(true, "Bullish")
showBear = input.bool(true, "Bearish")
showNeutral = input.bool(true, "Neutral")
trendMode = input.string("SMA50", "Detect Trend Based On", options=["SMA50", "SMA50, SMA200", "No detection"])
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
inUptrend = trendMode == "No detection" ? true : trendMode == "SMA50" ? close > sma50 : close > sma50 and sma50 > sma200
inDowntrend = trendMode == "No detection" ? true : trendMode == "SMA50" ? close < sma50 : close < sma50 and sma50 < sma200
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
bodySize = bodyTop - bodyBot
barRange = high - low
upperWick = high - bodyTop
lowerWick = bodyBot - low
avgBody = ta.ema(bodySize, 14)
isSmall = bodySize < avgBody
isLong = bodySize > avgBody
isBull = close > open
isBear = close < open
bodyMid = (bodyTop + bodyBot) * 0.5
isDojiBody = barRange > 0 and bodySize <= barRange * 0.05
sig_doji = showNeutral and (isDojiBody and upperWick > 0 and lowerWick > 0 and math.min(upperWick, lowerWick) / math.max(upperWick, lowerWick) >= 0.5)
sig_dragonfly_doji = showBull and (isDojiBody and upperWick <= barRange * 0.05 and lowerWick >= barRange * 0.6)
sig_gravestone_doji = showBear and (isDojiBody and lowerWick <= barRange * 0.05 and upperWick >= barRange * 0.6)
sig_hammer = showBull and (inDowntrend and isSmall and bodySize > 0 and lowerWick >= bodySize * 2.0 and upperWick <= barRange * 0.05)
sig_hanging_man = showBear and (inUptrend and isSmall and bodySize > 0 and lowerWick >= bodySize * 2.0 and upperWick <= barRange * 0.05)
sig_inverted_hammer = showBull and (inDowntrend and isSmall and bodySize > 0 and upperWick >= bodySize * 2.0 and lowerWick <= barRange * 0.05)
sig_shooting_star = showBear and (inUptrend and isSmall and bodySize > 0 and upperWick >= bodySize * 2.0 and lowerWick <= barRange * 0.05)
sig_marubozu_white = showBull and (isBull and isLong and upperWick <= bodySize * 0.05 and lowerWick <= bodySize * 0.05)
sig_marubozu_black = showBear and (isBear and isLong and upperWick <= bodySize * 0.05 and lowerWick <= bodySize * 0.05)
sig_spinning_top_white = showNeutral and (isBull and isSmall and bodySize > 0 and not isDojiBody and upperWick > bodySize and lowerWick > bodySize)
sig_spinning_top_black = showNeutral and (isBear and isSmall and bodySize > 0 and not isDojiBody and upperWick > bodySize and lowerWick > bodySize)
sig_long_lower_shadow = showBull and (barRange > 0 and lowerWick >= barRange * 0.75)
sig_long_upper_shadow = showBear and (barRange > 0 and upperWick >= barRange * 0.75)
sig_engulfing_bull = showBull and (inDowntrend and isBull and isLong and isBear[1] and isSmall[1] and close >= open[1] and open <= close[1] and (close > open[1] or open < close[1]))
sig_engulfing_bear = showBear and (inUptrend and isBear and isLong and isBull[1] and isSmall[1] and close <= open[1] and open >= close[1] and (close < open[1] or open > close[1]))
sig_harami_bull = showBull and (inDowntrend and isBear[1] and isLong[1] and isBull and isSmall and high <= bodyTop[1] and low >= bodyBot[1])
sig_harami_bear = showBear and (inUptrend and isBull[1] and isLong[1] and isBear and isSmall and high <= bodyTop[1] and low >= bodyBot[1])
sig_harami_cross_bull = showBull and (inDowntrend and isBear[1] and isLong[1] and isDojiBody and high <= bodyTop[1] and low >= bodyBot[1])
sig_harami_cross_bear = showBear and (inUptrend and isBull[1] and isLong[1] and isDojiBody and high <= bodyTop[1] and low >= bodyBot[1])
sig_piercing = showBull and (inDowntrend and isBear[1] and isLong[1] and isBull and open < low[1] and close > bodyMid[1] and close < open[1])
sig_dark_cloud_cover = showBear and (inUptrend and isBull[1] and isLong[1] and isBear and open > high[1] and close < bodyMid[1] and close > open[1])
sig_doji_star_bull = showBull and (inDowntrend and isBear[1] and isLong[1] and isDojiBody and bodyTop < bodyBot[1])
sig_doji_star_bear = showBear and (inUptrend and isBull[1] and isLong[1] and isDojiBody and bodyBot > bodyTop[1])
sig_morning_star = showBull and (inDowntrend[2] and isBear[2] and isLong[2] and isSmall[1] and bodyTop[1] < bodyBot[2] and isBull and isLong and close >= bodyMid[2])
sig_evening_star = showBear and (inUptrend[2] and isBull[2] and isLong[2] and isSmall[1] and bodyBot[1] > bodyTop[2] and isBear and isLong and close <= bodyMid[2])
sig_morning_doji_star = showBull and (inDowntrend[2] and isBear[2] and isLong[2] and isDojiBody[1] and bodyTop[1] < bodyBot[2] and isBull and isLong and close >= bodyMid[2])
sig_evening_doji_star = showBear and (inUptrend[2] and isBull[2] and isLong[2] and isDojiBody[1] and bodyBot[1] > bodyTop[2] and isBear and isLong and close <= bodyMid[2])
sig_abandoned_baby_bull = showBull and (inDowntrend[2] and isBear[2] and isLong[2] and isDojiBody[1] and high[1] < low[2] and isBull and isLong and low > high[1])
sig_abandoned_baby_bear = showBear and (inUptrend[2] and isBull[2] and isLong[2] and isDojiBody[1] and low[1] > high[2] and isBear and isLong and high < low[1])
sig_kicking_bull = showBull and (isBear[1] and isLong[1] and upperWick[1] <= bodySize[1] * 0.05 and lowerWick[1] <= bodySize[1] * 0.05 and isBull and isLong and upperWick <= bodySize * 0.05 and lowerWick <= bodySize * 0.05 and open > open[1])
sig_kicking_bear = showBear and (isBull[1] and isLong[1] and upperWick[1] <= bodySize[1] * 0.05 and lowerWick[1] <= bodySize[1] * 0.05 and isBear and isLong and upperWick <= bodySize * 0.05 and lowerWick <= bodySize * 0.05 and open < open[1])
sig_on_neck = showBear and (inDowntrend and isBear[1] and isLong[1] and isBull and open < low[1] and math.abs(close - low[1]) <= avgBody * 0.05)
sig_rising_window = showBull and (inUptrend[1] and barRange > 0 and barRange[1] > 0 and low > high[1])
sig_falling_window = showBear and (inDowntrend[1] and barRange > 0 and barRange[1] > 0 and high < low[1])
sig_upside_tasuki_gap = showBull and (inUptrend[2] and isBull[2] and isBull[1] and bodyBot[1] > bodyTop[2] and isBear and open >= bodyBot[1] and open <= bodyTop[1] and close < bodyBot[1] and close > bodyTop[2])
sig_downside_tasuki_gap = showBear and (inDowntrend[2] and isBear[2] and isBear[1] and bodyTop[1] < bodyBot[2] and isBull and open <= bodyTop[1] and open >= bodyBot[1] and close > bodyTop[1] and close < bodyBot[2])
sig_three_white_soldiers = showBull and (isBull and isBull[1] and isBull[2] and isLong and isLong[1] and isLong[2] and close > close[1] and close[1] > close[2] and open > open[1] and open < close[1] and open[1] > open[2] and open[1] < close[2] and upperWick <= barRange * 0.25 and upperWick[1] <= barRange[1] * 0.25 and upperWick[2] <= barRange[2] * 0.25)
sig_three_black_crows = showBear and (isBear and isBear[1] and isBear[2] and isLong and isLong[1] and isLong[2] and close < close[1] and close[1] < close[2] and open < open[1] and open > close[1] and open[1] < open[2] and open[1] > close[2] and lowerWick <= barRange * 0.25 and lowerWick[1] <= barRange[1] * 0.25 and lowerWick[2] <= barRange[2] * 0.25)
sig_rising_three_methods = showBull and (inUptrend[4] and isBull[4] and isLong[4] and isBear[3] and isSmall[3] and isBear[2] and isSmall[2] and isBear[1] and isSmall[1] and high[3] <= high[4] and low[3] >= low[4] and high[2] <= high[4] and low[2] >= low[4] and high[1] <= high[4] and low[1] >= low[4] and isBull and isLong and close > close[4])
sig_falling_three_methods = showBear and (inDowntrend[4] and isBear[4] and isLong[4] and isBull[3] and isSmall[3] and isBull[2] and isSmall[2] and isBull[1] and isSmall[1] and high[3] <= high[4] and low[3] >= low[4] and high[2] <= high[4] and low[2] >= low[4] and high[1] <= high[4] and low[1] >= low[4] and isBear and isLong and close < close[4])
sig_tri_star_bull = showBull and (inDowntrend[2] and isDojiBody[2] and isDojiBody[1] and isDojiBody and bodyTop[1] < bodyBot[2] and bodyTop[1] < bodyBot)
sig_tri_star_bear = showBear and (inUptrend[2] and isDojiBody[2] and isDojiBody[1] and isDojiBody and bodyBot[1] > bodyTop[2] and bodyBot[1] > bodyTop)
sig_tweezer_bottom = showBull and (inDowntrend[1] and isBear[1] and isBull and math.abs(low - low[1]) <= avgBody * 0.05)
sig_tweezer_top = showBear and (inUptrend[1] and isBull[1] and isBear and math.abs(high - high[1]) <= avgBody * 0.05)
plotshape(sig_doji, "Doji", style=shape.labeldown, location=location.abovebar, color=color.new(#787B86, 0), text="D", textcolor=color.white, size=size.small)
plotshape(sig_dragonfly_doji, "Dragonfly Doji", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="DD", textcolor=color.white, size=size.small)
plotshape(sig_gravestone_doji, "Gravestone Doji", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="GD", textcolor=color.white, size=size.small)
plotshape(sig_hammer, "Hammer", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="H", textcolor=color.white, size=size.small)
plotshape(sig_hanging_man, "Hanging Man", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="HM", textcolor=color.white, size=size.small)
plotshape(sig_inverted_hammer, "Inverted Hammer", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="IH", textcolor=color.white, size=size.small)
plotshape(sig_shooting_star, "Shooting Star", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="SS", textcolor=color.white, size=size.small)
plotshape(sig_marubozu_white, "Marubozu White", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="MW", textcolor=color.white, size=size.small)
plotshape(sig_marubozu_black, "Marubozu Black", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="MB", textcolor=color.white, size=size.small)
plotshape(sig_spinning_top_white, "Spinning Top White", style=shape.labeldown, location=location.abovebar, color=color.new(#787B86, 0), text="STW", textcolor=color.white, size=size.small)
plotshape(sig_spinning_top_black, "Spinning Top Black", style=shape.labeldown, location=location.abovebar, color=color.new(#787B86, 0), text="STB", textcolor=color.white, size=size.small)
plotshape(sig_long_lower_shadow, "Long Lower Shadow", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="LS", textcolor=color.white, size=size.small)
plotshape(sig_long_upper_shadow, "Long Upper Shadow", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="LS", textcolor=color.white, size=size.small)
plotshape(sig_engulfing_bull, "Engulfing - Bullish", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="BE", textcolor=color.white, size=size.small)
plotshape(sig_engulfing_bear, "Engulfing - Bearish", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="BE", textcolor=color.white, size=size.small)
plotshape(sig_harami_bull, "Harami - Bullish", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="BH", textcolor=color.white, size=size.small)
plotshape(sig_harami_bear, "Harami - Bearish", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="BH", textcolor=color.white, size=size.small)
plotshape(sig_harami_cross_bull, "Harami Cross - Bullish", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="HC", textcolor=color.white, size=size.small)
plotshape(sig_harami_cross_bear, "Harami Cross - Bearish", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="HC", textcolor=color.white, size=size.small)
plotshape(sig_piercing, "Piercing", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="P", textcolor=color.white, size=size.small)
plotshape(sig_dark_cloud_cover, "Dark Cloud Cover", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="DCC", textcolor=color.white, size=size.small)
plotshape(sig_doji_star_bull, "Doji Star - Bullish", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="DS", textcolor=color.white, size=size.small)
plotshape(sig_doji_star_bear, "Doji Star - Bearish", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="DS", textcolor=color.white, size=size.small)
plotshape(sig_morning_star, "Morning Star", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="MS", textcolor=color.white, size=size.small)
plotshape(sig_evening_star, "Evening Star", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="ES", textcolor=color.white, size=size.small)
plotshape(sig_morning_doji_star, "Morning Doji Star", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="MDS", textcolor=color.white, size=size.small)
plotshape(sig_evening_doji_star, "Evening Doji Star", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="EDS", textcolor=color.white, size=size.small)
plotshape(sig_abandoned_baby_bull, "Abandoned Baby - Bullish", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="AB", textcolor=color.white, size=size.small)
plotshape(sig_abandoned_baby_bear, "Abandoned Baby - Bearish", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="AB", textcolor=color.white, size=size.small)
plotshape(sig_kicking_bull, "Kicking - Bullish", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="K", textcolor=color.white, size=size.small)
plotshape(sig_kicking_bear, "Kicking - Bearish", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="K", textcolor=color.white, size=size.small)
plotshape(sig_on_neck, "On Neck", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="ON", textcolor=color.white, size=size.small)
plotshape(sig_rising_window, "Rising Window", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="RW", textcolor=color.white, size=size.small)
plotshape(sig_falling_window, "Falling Window", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="FW", textcolor=color.white, size=size.small)
plotshape(sig_upside_tasuki_gap, "Upside Tasuki Gap", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="UTG", textcolor=color.white, size=size.small)
plotshape(sig_downside_tasuki_gap, "Downside Tasuki Gap", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="DTG", textcolor=color.white, size=size.small)
plotshape(sig_three_white_soldiers, "Three White Soldiers", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="3WS", textcolor=color.white, size=size.small)
plotshape(sig_three_black_crows, "Three Black Crows", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="3BC", textcolor=color.white, size=size.small)
plotshape(sig_rising_three_methods, "Rising Three Methods", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="R3M", textcolor=color.white, size=size.small)
plotshape(sig_falling_three_methods, "Falling Three Methods", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="F3M", textcolor=color.white, size=size.small)
plotshape(sig_tri_star_bull, "Tri-Star - Bullish", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="3S", textcolor=color.white, size=size.small)
plotshape(sig_tri_star_bear, "Tri-Star - Bearish", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="3S", textcolor=color.white, size=size.small)
plotshape(sig_tweezer_bottom, "Tweezer Bottom", style=shape.labelup, location=location.belowbar, color=color.new(#089981, 0), text="TB", textcolor=color.white, size=size.small)
plotshape(sig_tweezer_top, "Tweezer Top", style=shape.labeldown, location=location.abovebar, color=color.new(#F23645, 0), text="TT", textcolor=color.white, size=size.small)
