// @tr Keltner Kanal Genişliği
// @category volatility
// @desc Kanal genişliğinin ortaya oranı
indicator("Keltner Channel Width", "KCW", overlay=false, format=format.price, precision=4)
length = input.int(20, "Length", minval=1)
mult = input.float(2.0, "Multiplier")
plot(ta.kcw(close, length, mult), "KCW", color=#0284C7)
