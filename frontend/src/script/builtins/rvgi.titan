// @tr Göreceli Canlılık Endeksi
// @category osc
// @desc Kapanış-açılış/aralık oranı ve sinyal
indicator("Relative Vigor Index", "RVGI", overlay=false, format=format.price, precision=4)
period = input.int(10, "Length", minval=1)
num = math.sum(ta.swma(close - open), period)
den = math.sum(ta.swma(high - low), period)
rviVal = num / den
sigVal = ta.swma(rviVal)
plot(rviVal, "RVGI", color=#089981)
plot(sigVal, "Signal", color=#F23645)
