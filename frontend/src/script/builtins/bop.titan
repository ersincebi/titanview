// @tr Güç Dengesi
// @category osc
// @desc (Kapanış − açılış) / (yüksek − düşük)
indicator("Balance of Power", "BOP", overlay=false, format=format.price, precision=2)
span = high - low
power = span == 0 ? 0.0 : (close - open) / span
plot(power, "BOP", color=#F23645)
hline(0, "Zero", color=#64748B)
