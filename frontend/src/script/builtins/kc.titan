//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Keltner Kanalları
// @category volatility
// @desc EMA ± ATR (veya aralık) kanalı
indicator("Keltner Channels", "KC", overlay=true)
period = input.int(20, "Length", minval=1)
mult = input.float(2.0, "Multiplier", step=0.1)
price = input.source(close, "Source")
useEma = input.bool(true, "Use Exponential MA")
bandMode = input.string("Average True Range", "Bands Style", options=["Average True Range", "True Range", "Range"])
atrLen = input.int(10, "ATR Length", minval=1)
center = useEma ? ta.ema(price, period) : ta.sma(price, period)
bandWidth = bandMode == "True Range" ? ta.tr(true) : bandMode == "Average True Range" ? ta.atr(atrLen) : ta.rma(high - low, period)
uPlot = plot(center + bandWidth * mult, "Upper", color=#0284C7)
plot(center, "Basis", color=#0284C7)
lPlot = plot(center - bandWidth * mult, "Lower", color=#0284C7)
fill(uPlot, lPlot, color=color.new(#0284C7, 92), title="Background")
