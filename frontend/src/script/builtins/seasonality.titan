//@version=6
// SPDX-License-Identifier: AGPL-3.0-or-later
// @tr Mevsimsellik
// @category other
// @desc Aylara göre ortalama getiri tablosu
indicator("Seasonality", "Seasonality", overlay=false)
var array<float> sums = array.new<float>(12, 0.0)
var array<int> cnts = array.new<int>(12, 0)
var float monthOpen = na
if timeframe.change("M")
    if not na(monthOpen) and not na(close[1])
        m = month(time[1]) - 1
        array.set(sums, m, array.get(sums, m) + (close[1] - monthOpen) / monthOpen * 100)
        array.set(cnts, m, array.get(cnts, m) + 1)
    monthOpen := open
m0 = month(time) - 1
avg = array.get(cnts, m0) > 0 ? array.get(sums, m0) / array.get(cnts, m0) : na
plot(avg, "Avg Monthly Return %", style=plot.style_columns, color=avg >= 0 ? #089981 : #F23645)
var table t = table.new(position.top_right, 13, 2, border_width=1)
if barstate.islast
    names = array.from("Oca", "Şub", "Mar", "Nis", "May", "Haz", "Tem", "Ağu", "Eyl", "Eki", "Kas", "Ara")
    table.cell(t, 0, 0, "Ay", text_color=color.white, bgcolor=#363A45)
    table.cell(t, 0, 1, "Ort %", text_color=color.white, bgcolor=#363A45)
    for i = 0 to 11
        c = array.get(cnts, i)
        v = c > 0 ? array.get(sums, i) / c : na
        table.cell(t, i + 1, 0, array.get(names, i), text_color=color.white, bgcolor=#363A45)
        table.cell(t, i + 1, 1, na(v) ? "—" : str.tostring(v, "#.##"), text_color=color.white, bgcolor=na(v) ? #363A45 : v >= 0 ? color.new(#089981, 40) : color.new(#F23645, 40))
