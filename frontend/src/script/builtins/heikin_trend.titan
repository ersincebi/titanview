// @tr Heikin Ashi Trend Mumları
// @category trend
// @desc Heikin Ashi mumları ayrı panelde
indicator("Heikin Ashi Candles", "HA", overlay=false)
haClose = (open + high + low + close) / 4
haOpen = 0.0
haOpen := na(haOpen[1]) ? (open + close) / 2 : (haOpen[1] + haClose[1]) / 2
haHigh = math.max(high, math.max(haOpen, haClose))
haLow = math.min(low, math.min(haOpen, haClose))
plotcandle(haOpen, haHigh, haLow, haClose, "Heikin Ashi", color=haClose >= haOpen ? #089981 : #F23645, wickcolor=#787B86, bordercolor=haClose >= haOpen ? #089981 : #F23645)
