// @tr Standart Sapma
// @category volatility
// @desc Kaynağın N barlık standart sapması
indicator("Standard Deviation", "StDev", overlay=false)
period = input.int(20, "Length", minval=1)
price = input.source(close, "Source")
plot(ta.stdev(price, period), "StDev", color=#0284C7)
