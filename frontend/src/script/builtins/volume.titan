// @tr Hacim
// @category volume
// @desc Bar hacmi ve hareketli ortalaması
indicator("Volume", "Vol", overlay=false, format=format.volume)
showMA = input.bool(false, "Show MA")
maLength = input.int(20, "MA Length", minval=1)
upColor = input.color(color.rgb(8, 153, 129, 50), "Growing")
downColor = input.color(color.rgb(242, 54, 69, 50), "Falling")
plot(volume, "Volume", style=plot.style_columns, color=close >= open ? upColor : downColor)
plot(showMA ? ta.sma(volume, maLength) : na, "Volume MA", color=#0284C7)
