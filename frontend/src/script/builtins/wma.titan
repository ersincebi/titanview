// @tr Ağırlıklı Hareketli Ortalama
// @category ma
// @desc Doğrusal ağırlıklı ortalama
indicator("Moving Average Weighted", "WMA", overlay=true)
period = input.int(9, "Length", minval=1)
price = input.source(close, "Source")
shift = input.int(0, "Offset", minval=-500, maxval=500)
plot(ta.wma(price, period), "WMA", color=#0284C7, offset=shift)
