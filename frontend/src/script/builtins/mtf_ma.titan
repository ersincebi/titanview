// @tr Çoklu Zaman Dilimi Ortalaması
// @category other
// @desc Üst zaman diliminin hareketli ortalaması (repaint yok)
indicator("Multi-Timeframe Moving Average", "MTF MA", overlay=true)
tf = input.timeframe("W", "Timeframe")
len = input.int(20, "Length", minval=1)
useEma = input.bool(false, "EMA")
v = request.security(syminfo.tickerid, tf, useEma ? ta.ema(close, len) : ta.sma(close, len))
plot(v, "MTF MA", color=#FF9800, linewidth=2)
