// @tr Göreli Hacim
// @category volume
// @desc Hacim / ortalama hacim
indicator("Relative Volume", "RVOL", overlay=false, format=format.price, precision=2)
length = input.int(20, "Length", minval=1)
rv = volume / ta.sma(volume, length)
plot(rv, "RVOL", style=plot.style_columns, color=rv >= 2 ? #FF9800 : rv >= 1 ? #0284C7 : #787B86)
hline(1, "Average", color=#787B86, linestyle=hline.style_dashed)
